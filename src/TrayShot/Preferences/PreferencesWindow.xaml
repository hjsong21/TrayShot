<Window x:Class="TrayShot.Preferences.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Pref_WindowTitle}" Width="550" Height="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <TabControl Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border"
                                        Background="{DynamicResource TabUnselectedBackgroundBrush}"
                                        BorderBrush="{DynamicResource TabUnselectedBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6,6,0,0"
                                        Margin="0,0,6,0"
                                        Padding="16,8">
                                    <ContentPresenter x:Name="ContentSite"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      ContentSource="Header"
                                                      TextElement.Foreground="{DynamicResource TabUnselectedTextBrush}"
                                                      TextElement.FontSize="13"
                                                      TextElement.FontWeight="Medium" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True" />
                                            <Condition Property="IsSelected" Value="False" />
                                            <Condition Property="IsEnabled" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}" />
                                    </MultiTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource TabSelectedBackgroundBrush}" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TabSelectedBorderBrush}" />
                                        <Setter TargetName="Border" Property="BorderThickness" Value="1" />
                                        <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource TabSelectedTextBrush}" />
                                        <Setter TargetName="ContentSite" Property="TextElement.FontWeight" Value="Bold" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Border" Property="Opacity" Value="0.45" />
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource TabUnselectedBackgroundBrush}" />
                                        <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <!-- 일반 탭 -->
            <TabItem Header="{DynamicResource Pref_Tab_General}" Foreground="{DynamicResource TextPrimaryBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,16">

                        <!-- 1. 언어 (Language) -->
                        <TextBlock Text="{DynamicResource Pref_Language_Section}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Pref_Language_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedLanguageIndex}" Width="250" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="{DynamicResource Pref_Language_System}" />
                                    <ComboBoxItem Content="{DynamicResource Pref_Language_Korean}" />
                                    <ComboBoxItem Content="{DynamicResource Pref_Language_English}" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <TextBlock Text="{DynamicResource Pref_Language_Note}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="4,0,0,20" />

                        <!-- 2. 시작 (Startup) -->
                        <TextBlock Text="{DynamicResource Pref_Startup_Section}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Pref_LaunchAtStartup_Label}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding LaunchAtStartup}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 3. 단축키 (Hotkey) -->
                        <TextBlock Text="{DynamicResource Pref_Hotkey_Section}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Pref_Hotkey_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="HotKeyTextBox"
                                                 Text="{Binding HotKeyDisplayText, Mode=OneWay}"
                                                 Width="180" Padding="8,5" FontSize="13" FontWeight="Bold" HorizontalContentAlignment="Center"
                                                 IsReadOnly="True" Cursor="Hand"
                                                 Background="{DynamicResource WindowBackgroundBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{Binding HotKeyBorderBrush}" BorderThickness="1.5"
                                                 PreviewKeyDown="HotKeyTextBox_PreviewKeyDown"
                                                 GotFocus="HotKeyTextBox_GotFocus" />
                                        <Border Margin="8,0,0,0" Padding="8,4" Background="#FF5252" CornerRadius="4" VerticalAlignment="Center"
                                                Visibility="{Binding HasConflict, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource Pref_Hotkey_Conflict}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding HotKeyStatusText}"
                                           Foreground="{Binding HotKeyStatusBrush}"
                                           FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource Pref_Hotkey_Desc}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="4,0,0,20" />

                        <!-- 4. 화면 테마 (Theme) -->
                        <TextBlock Text="{DynamicResource Pref_Theme_Section}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Pref_Theme_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedThemeIndex}" Width="250" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="{DynamicResource Pref_Theme_Dark}" />
                                    <ComboBoxItem Content="{DynamicResource Pref_Theme_Light}" />
                                    <ComboBoxItem Content="{DynamicResource Pref_Theme_System}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- 5. 갤러리 패널 크기 (Panel Size) -->
                        <TextBlock Text="{DynamicResource Pref_GallerySize_Section}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Pref_GallerySize_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding GallerySizeDisplayText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <Button Grid.Column="2" Content="{DynamicResource Pref_ResetGallerySize}"
                                        Command="{Binding ResetGallerySizeCommand}"
                                        Padding="10,5" FontSize="12"
                                        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                        Cursor="Hand" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 변환 탭 -->
            <TabItem Header="{DynamicResource Pref_Tab_Conversion}" Foreground="{DynamicResource TextPrimaryBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,16">
                        <!-- WebP 섹션 -->
                        <TextBlock Text="{DynamicResource Pref_Webp_Section}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14,14" Margin="0,0,0,6">
                            <StackPanel>
                                <!-- 1. 새 스크린샷을 WebP 형식으로 변환 -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Pref_WebpAutoConversion_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource Pref_WebpAutoConversion_Note}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding WebpConversionEnabled}" VerticalAlignment="Center" />
                                </Grid>

                                <Separator Background="{DynamicResource BorderBrushColor}" Margin="0,8,0,12" />

                                <!-- 2. 원본 PNG 이미지 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Pref_DisposalPolicy_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedDisposalIndex}" Width="250" HorizontalAlignment="Right">
                                        <ComboBoxItem Content="{DynamicResource Pref_Disposal_Trash}" />
                                        <ComboBoxItem Content="{DynamicResource Pref_Disposal_Delete}" />
                                        <ComboBoxItem Content="{DynamicResource Pref_Disposal_Keep}" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource Pref_Disposal_Note}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="4,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 검색 탭 (비활성화) -->
            <TabItem Header="{DynamicResource Pref_Tab_SearchOcr}" Foreground="{DynamicResource TextPrimaryBrush}" IsEnabled="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,16">
                        <!-- 1. OCR 섹션 -->
                        <TextBlock Text="{DynamicResource Pref_Ocr_Section}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14,14" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Pref_OcrEnabled_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Pref_OcrEnabled_Note}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding OcrEnabled}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 2. 시맨틱 AI 섹션 -->
                        <TextBlock Text="{DynamicResource Pref_Semantic_Section}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Pref_SemanticEnabled_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Pref_SemanticEnabled_Note}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding SemanticSearchEnabled}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
