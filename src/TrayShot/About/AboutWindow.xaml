<Window x:Class="TrayShot.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About_WindowTitle}" Icon="pack://application:,,,/assets/app.ico" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Padding="24" CornerRadius="12">
        <StackPanel>
            <!-- Header Section -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <!-- App Icon Image -->
                <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center" ClipToBounds="True">
                    <Image Source="pack://application:,,,/assets/app.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TrayShot" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" />
                    <TextBlock x:Name="VersionTextBlock" Text="버전 0.7.0 (Win-x64)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Separator Background="{DynamicResource BorderBrushColor}" Margin="0,0,0,16" />

            <!-- Description & Feature Highlights -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String_AppDescription}"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Text="{DynamicResource About_Feature1}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource About_Feature2}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource About_Feature3}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource About_Feature4}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource About_Feature5}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Copyright -->
            <TextBlock x:Name="CopyrightTextBlock" Text="Copyright © 2026 TrayShot. All rights reserved."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,16" />

            <!-- Close Button -->
            <Border Background="#2563EB" CornerRadius="6" HorizontalAlignment="Center" Width="100">
                <Button Click="OnCloseClick" Content="{DynamicResource String_OK}" Padding="0,8"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        Cursor="Hand" FontWeight="Bold" />
            </Border>
        </StackPanel>
    </Border>
</Window>
