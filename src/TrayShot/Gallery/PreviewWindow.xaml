<Window x:Class="TrayShot.Gallery.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickLook Preview" WindowStyle="None" AllowsTransparency="True"
        Background="#D0000000" WindowStartupLocation="CenterScreen"
        Width="900" Height="650" KeyDown="OnKeyDown">
    <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <!-- Image Viewer -->
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="20" />

            <!-- Title Header -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,15,0,0"
                    Background="#90000000" CornerRadius="12" Padding="16,6">
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="SemiBold" />
            </Border>

            <!-- Close Button -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15"
                    Content="✕" Width="30" Height="30" Foreground="White" Background="#40FFFFFF"
                    BorderThickness="0" Click="CloseButton_Click" Cursor="Hand" />
        </Grid>
    </Border>
</Window>
