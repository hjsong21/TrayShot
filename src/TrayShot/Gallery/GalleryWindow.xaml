<Window x:Class="TrayShot.Gallery.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gallery="clr-namespace:TrayShot.Gallery"
        Title="TrayShot Gallery" Icon="pack://application:,,,/assets/app.ico" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        Width="664" Height="480" MinWidth="400" MinHeight="300" MaxWidth="1400" MaxHeight="900"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="6">
        <!-- Main window content card -->
        <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Bar: Search Bar (Left) + Settings/Exit Buttons (Right) -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Bar -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🔍" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                                     FontSize="14" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" CaretBrush="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Gallery_SearchPlaceholder}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSearchQuery}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Clear Search Keyword Button (x) -->
                            <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" ToolTip="{DynamicResource Gallery_ClearSearchToolTip}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0" Margin="4,0,0,0"
                                    Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="✖" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Action Buttons: Settings Button (opens Context Menu) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Settings Button (Mechanical Gear Vector Icon) -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8">
                            <Button Click="OnSettingsButtonClick" ToolTip="{DynamicResource Gallery_SettingsToolTip}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="10,6">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="SettingsMenu">
                                        <MenuItem Header="{DynamicResource Tray_Settings}" Click="OnOpenSettingsClick" />
                                        <MenuItem Header="{DynamicResource Tray_About}" Click="OnOpenAboutClick" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Tray_Exit}" Click="OnExitAppClick" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Path Data="M 12,15 A 3,3 0 1,0 12,9 A 3,3 0 1,0 12,15 Z M 19.43,12.97 C 19.47,12.65 19.5,12.33 19.5,12 C 19.5,11.67 19.47,11.34 19.43,11.03 L 21.54,9.37 C 21.73,9.22 21.78,8.95 21.66,8.73 L 19.66,5.27 C 19.54,5.05 19.27,4.96 19.05,5.05 L 16.56,6.05 C 16.04,5.66 15.48,5.32 14.87,5.07 L 14.49,2.42 C 14.46,2.18 14.25,2 14,2 H 10 C 9.75,2 9.54,2.18 9.51,2.42 L 9.13,5.07 C 8.52,5.32 7.96,5.66 7.44,6.05 L 4.95,5.05 C 4.73,4.96 4.46,5.05 4.34,5.27 L 2.34,8.73 C 2.21,8.95 2.27,9.22 2.46,9.37 L 4.57,11.03 C 4.53,11.34 4.5,11.67 4.5,12 C 4.5,12.33 4.53,12.65 4.57,12.97 L 2.46,14.63 C 2.27,14.78 2.21,15.05 2.34,15.27 L 4.34,18.73 C 4.46,18.95 4.73,19.03 4.95,18.95 L 7.44,17.95 C 7.96,18.34 8.52,18.68 9.13,18.93 L 9.51,21.58 C 9.54,21.82 9.75,22 10,22 H 14 C 14.25,22 14.46,21.82 14.87,18.93 C 15.48,18.68 16.04,18.34 16.56,17.95 L 19.05,18.95 C 19.27,19.03 19.54,18.95 19.66,18.95 L 21.66,15.27 C 21.78,15.05 21.73,14.78 21.54,14.63 L 19.43,12.97 Z"
                                      Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="16" Height="16" />
                            </Button>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Date-grouped gallery view -->
                <ScrollViewer x:Name="GalleryScrollViewer" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="GroupItemsControl"
                                  ItemsSource="{Binding GroupedScreenshots}"
                                  Background="Transparent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <!-- Date group header -->
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Margin="4,8,0,8" />

                                    <!-- Screenshots in this date group -->
                                    <ItemsControl x:Name="DayItemsControl"
                                                  ItemsSource="{Binding Items}"
                                                  Background="Transparent"
                                                  MouseDoubleClick="OnItemMouseDoubleClick"
                                                  PreviewMouseMove="OnItemPreviewMouseMove">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <gallery:ScreenshotItemControl ScreenshotItem="{Binding}"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    PreviewMouseLeftButtonDown="OnItemPreviewMouseLeftButtonDown"
                                                    PreviewMouseLeftButtonUp="OnItemPreviewMouseLeftButtonUp"
                                                    PreviewMouseRightButtonDown="OnItemPreviewMouseRightButtonDown">
                                                    <gallery:ScreenshotItemControl.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{DynamicResource Gallery_ContextMenu_View}" InputGestureText="Space"
                                                                      Command="{Binding PlacementTarget.Tag.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.Tag.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <Separator />
                                                            <MenuItem Header="{DynamicResource Gallery_ContextMenu_Copy}" InputGestureText="Ctrl+C"
                                                                      Command="{Binding PlacementTarget.Tag.CopySelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="{DynamicResource Gallery_ContextMenu_Paste}" InputGestureText="Ctrl+V"
                                                                      Command="{Binding PlacementTarget.Tag.PasteClipboardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <Separator />
                                                            <MenuItem Header="{DynamicResource Gallery_ContextMenu_ConvertFormat}">
                                                                <MenuItem Header="PNG" Command="{Binding PlacementTarget.Tag.ConvertFormatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="png" IsEnabled="{Binding PlacementTarget.Tag.IsNotPng, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="JPG" Command="{Binding PlacementTarget.Tag.ConvertFormatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="jpg" IsEnabled="{Binding PlacementTarget.Tag.IsNotJpg, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="WebP" Command="{Binding PlacementTarget.Tag.ConvertFormatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="webp" IsEnabled="{Binding PlacementTarget.Tag.IsNotWebp, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="BMP" Command="{Binding PlacementTarget.Tag.ConvertFormatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="bmp" IsEnabled="{Binding PlacementTarget.Tag.IsNotBmp, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="GIF" Command="{Binding PlacementTarget.Tag.ConvertFormatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="gif" IsEnabled="{Binding PlacementTarget.Tag.IsNotGif, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="TIFF" Command="{Binding PlacementTarget.Tag.ConvertFormatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="tiff" IsEnabled="{Binding PlacementTarget.Tag.IsNotTiff, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="HEIC" Command="{Binding PlacementTarget.Tag.ConvertFormatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="heic" IsEnabled="{Binding PlacementTarget.Tag.IsNotHeic, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="{DynamicResource Gallery_ContextMenu_Delete}" InputGestureText="Del"
                                                                      Command="{Binding PlacementTarget.Tag.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="{DynamicResource Gallery_ContextMenu_Undo}" InputGestureText="Ctrl+Z"
                                                                      Command="{Binding PlacementTarget.Tag.UndoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </gallery:ScreenshotItemControl.ContextMenu>
                                                </gallery:ScreenshotItemControl>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state message -->
                <TextBlock Grid.Row="1" Text="{DynamicResource Gallery_EmptyState}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Toast Notification Banner for Format Conversion & Status -->
                <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                        Background="#E61F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="20" Padding="14,8"
                        Panel.ZIndex="100"
                        Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Left resize border handle -->
        <Rectangle HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="8"
                   Fill="Transparent" Cursor="SizeWE"
                   PreviewMouseLeftButtonDown="ResizeLeft_MouseDown" />

        <!-- Top resize border handle -->
        <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="8"
                   Fill="Transparent" Cursor="SizeNS"
                   PreviewMouseLeftButtonDown="ResizeTop_MouseDown" />

        <!-- Top-Left corner resize handle -->
        <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="14"
                   Fill="Transparent" Cursor="SizeNWSE"
                   PreviewMouseLeftButtonDown="ResizeTopLeft_MouseDown" />
    </Grid>
</Window>
