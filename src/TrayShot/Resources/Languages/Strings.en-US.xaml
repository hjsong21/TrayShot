<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!-- App / General -->
    <system:String x:Key="String_AppName">TrayShot</system:String>
    <system:String x:Key="String_AppDescription">Smart Windows Screenshot Gallery &amp; Image Manager</system:String>
    <system:String x:Key="String_OK">OK</system:String>
    <system:String x:Key="String_Cancel">Cancel</system:String>

    <!-- Gallery Window -->
    <system:String x:Key="Gallery_SearchPlaceholder">Search screenshots...</system:String>
    <system:String x:Key="Gallery_ClearSearchToolTip">Clear search</system:String>
    <system:String x:Key="Gallery_SettingsToolTip">Settings</system:String>
    <system:String x:Key="Gallery_AboutToolTip">About TrayShot</system:String>
    <system:String x:Key="Gallery_ExitToolTip">Exit App</system:String>
    <system:String x:Key="Gallery_EmptyState">No screenshots found.</system:String>

    <!-- Context Menu -->
    <system:String x:Key="Gallery_ContextMenu_View">View</system:String>
    <system:String x:Key="Gallery_ContextMenu_Copy">Copy</system:String>
    <system:String x:Key="Gallery_ContextMenu_Paste">Paste</system:String>
    <system:String x:Key="Gallery_ContextMenu_ConvertFormat">Convert Format</system:String>
    <system:String x:Key="Gallery_ContextMenu_Delete">Delete</system:String>
    <system:String x:Key="Gallery_ContextMenu_Undo">Undo</system:String>

    <!-- Status Toast -->
    <system:String x:Key="Gallery_Status_Converting">⏳ Converting {0} → {1}...</system:String>
    <system:String x:Key="Gallery_Status_Converted">✅ Converted to {0}!</system:String>
    <system:String x:Key="Gallery_Status_Failed">❌ Failed to convert to {0}</system:String>

    <!-- Preferences Window -->
    <system:String x:Key="Pref_WindowTitle">TrayShot Preferences</system:String>
    <system:String x:Key="Pref_Tab_General">General</system:String>
    <system:String x:Key="Pref_Tab_SearchOcr">Search &amp; OCR</system:String>
    <system:String x:Key="Pref_Tab_Conversion">Image Conversion</system:String>
    <system:String x:Key="Pref_Language_Section">Language</system:String>
    <system:String x:Key="Pref_Language_Title">Display Language</system:String>
    <system:String x:Key="Pref_Language_Note">Changing language applies immediately without restarting the app.</system:String>
    <system:String x:Key="Pref_Language_System">System Language</system:String>
    <system:String x:Key="Pref_Language_Korean">Korean (한국어)</system:String>
    <system:String x:Key="Pref_Language_English">English</system:String>
    <system:String x:Key="Pref_Startup_Section">Startup</system:String>
    <system:String x:Key="Pref_LaunchAtStartup_Label">Launch TrayShot on Login</system:String>
    <system:String x:Key="Pref_Hotkey_Section">Hotkey</system:String>
    <system:String x:Key="Pref_Hotkey_Title">Toggle Gallery</system:String>
    <system:String x:Key="Pref_Hotkey_Desc">Set a hotkey to instantly open TrayShot's image panel.</system:String>
    <system:String x:Key="Pref_Hotkey_Conflict">⚠️ Conflict</system:String>
    <system:String x:Key="Pref_Hotkey_Status_Active">✓ Currently active hotkey</system:String>
    <system:String x:Key="Pref_Theme_Section">Appearance Theme</system:String>
    <system:String x:Key="Pref_Theme_Title">Theme Mode</system:String>
    <system:String x:Key="Pref_Theme_Dark">🌙 Dark Mode</system:String>
    <system:String x:Key="Pref_Theme_Light">☀️ Light Mode</system:String>
    <system:String x:Key="Pref_Theme_System">💻 Sync with System</system:String>
    <system:String x:Key="Pref_GallerySize_Section">Gallery Panel Size</system:String>
    <system:String x:Key="Pref_GallerySize_Title">Panel Resolution (Width × Height)</system:String>
    <system:String x:Key="Pref_ResetGallerySize">Reset to Default</system:String>
    <system:String x:Key="Pref_Ocr_Section">Text Recognition (OCR)</system:String>
    <system:String x:Key="Pref_OcrEnabled_Title">Auto Extract Text &amp; Search</system:String>
    <system:String x:Key="Pref_OcrEnabled_Note">Recognizes text in screenshots automatically so you can search them.</system:String>
    <system:String x:Key="Pref_Semantic_Section">Semantic Search (AI)</system:String>
    <system:String x:Key="Pref_SemanticEnabled_Title">MobileCLIP Semantic Search</system:String>
    <system:String x:Key="Pref_SemanticEnabled_Note">Find screenshots by describing scenes, objects, or content concepts.</system:String>
    <system:String x:Key="Pref_Webp_Section">WebP</system:String>
    <system:String x:Key="Pref_WebpAutoConversion_Title">Convert new screenshots to WebP format</system:String>
    <system:String x:Key="Pref_WebpAutoConversion_Note">File size is typically 2/3 smaller than PNG, but lossy-free so image quality remains identical.</system:String>
    <system:String x:Key="Pref_DisposalPolicy_Title">Original PNG Image</system:String>
    <system:String x:Key="Pref_Disposal_Trash">Move to Recycle Bin (Default)</system:String>
    <system:String x:Key="Pref_Disposal_Delete">Delete Permanently</system:String>
    <system:String x:Key="Pref_Disposal_Keep">Keep Original PNG</system:String>
    <system:String x:Key="Pref_Disposal_Note">* Source file is disposed only after 1:1 pixel verification and size reduction checks pass.</system:String>

    <!-- About Window -->
    <system:String x:Key="About_WindowTitle">About TrayShot</system:String>
    <system:String x:Key="About_VersionPrefix">Version</system:String>
    <system:String x:Key="About_Feature1">• Real-time screenshot folder watcher &amp; fast thumbnail gallery</system:String>
    <system:String x:Key="About_Feature2">• Convert image formats including HEIC, PNG, JPG, WebP, BMP, GIF, TIFF</system:String>
    <system:String x:Key="About_Feature3">• Windows Recycle Bin integration &amp; Ctrl+Z Undo support</system:String>
    <system:String x:Key="About_Feature4">• 2-way Clipboard integration with File Explorer, Chat apps, Web Browsers</system:String>
    <system:String x:Key="About_Feature5">• Customizable global hotkey (Default: Ctrl + Alt + S)</system:String>

    <!-- System Tray -->
    <system:String x:Key="Tray_Toggle">Open Gallery</system:String>
    <system:String x:Key="Tray_Settings">Preferences...</system:String>
    <system:String x:Key="Tray_About">About TrayShot</system:String>
    <system:String x:Key="Tray_Exit">Exit TrayShot</system:String>
</ResourceDictionary>
