<Application x:Class="TrayShot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TrayShot"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Languages/Strings.ko-KR.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="BorderBrushColor" Color="#3A3A3A" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#888888" />
            <SolidColorBrush x:Key="ItemCardBackgroundBrush" Color="#1E1E1E" />

            <!-- TabControl Brushes Defaults -->
            <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="TabSelectedTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TabSelectedBorderBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="TabUnselectedBackgroundBrush" Color="#E5E7EB" />
            <SolidColorBrush x:Key="TabUnselectedTextBrush" Color="#4B5563" />
            <SolidColorBrush x:Key="TabUnselectedBorderBrush" Color="#D1D5DB" />
            <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#D1D5DB" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
