<Window x:Class="Sukurini.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sukurini 정보" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Padding="24" CornerRadius="12">
        <StackPanel>
            <!-- Header Section -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <!-- App Icon Placeholder Badge -->
                <Border Width="48" Height="48" CornerRadius="12" Background="#2563EB" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="🖼️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sukurini (수쿠리니)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" />
                    <TextBlock x:Name="VersionTextBlock" Text="버전 0.7.0 (Win-x64)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Separator Background="{DynamicResource BorderBrushColor}" Margin="0,0,0,16" />

            <!-- Description & Feature Highlights -->
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Windows 스마트 스크린샷 갤러리 &amp; 이미지 매니저"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Text="• 캡처 폴더 실시간 자동 감지 및 Fast 썸네일 브라우징" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <TextBlock Text="• HEIC 포함 주요 이미지 포맷 변환 (PNG, JPG, WebP, BMP, GIF, TIFF)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <TextBlock Text="• 윈도우 휴지통 연동 및 Ctrl+Z 삭제/붙여넣기 실행 취소" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <TextBlock Text="• 윈도우 탐색기 / 카카오톡 / 웹 브라우저 양방향 클립보드 (Ctrl+C, Ctrl+V)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <TextBlock Text="• 사용자 지정 전역 단축키 (기본: Ctrl + Alt + S)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Copyright -->
            <TextBlock Text="Copyright © 2026 Sukurini. All rights reserved."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,16" />

            <!-- Close Button -->
            <Border Background="#2563EB" CornerRadius="6" HorizontalAlignment="Center" Width="100">
                <Button Click="OnCloseClick" Content="확인" Padding="0,8"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        Cursor="Hand" FontWeight="Bold" />
            </Border>
        </StackPanel>
    </Border>
</Window>
