<Window x:Class="Sukurini.Preferences.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Pref_WindowTitle}" Width="550" Height="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <TabControl Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border"
                                        Background="#374151"
                                        BorderBrush="#4B5563"
                                        BorderThickness="1"
                                        CornerRadius="6,6,0,0"
                                        Margin="0,0,4,0"
                                        Padding="14,8">
                                    <ContentPresenter x:Name="ContentSite"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      ContentSource="Header"
                                                      TextElement.Foreground="White"
                                                      TextElement.FontSize="13"
                                                      TextElement.FontWeight="SemiBold" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True" />
                                            <Condition Property="IsSelected" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Border" Property="Background" Value="#4B5563" />
                                    </MultiTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#1F2937" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB" />
                                        <Setter TargetName="Border" Property="BorderThickness" Value="1,1,1,0" />
                                        <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="White" />
                                        <Setter TargetName="ContentSite" Property="TextElement.FontWeight" Value="Bold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <!-- 일반 탭 -->
            <TabItem Header="{DynamicResource Pref_Tab_General}" Foreground="{DynamicResource TextPrimaryBrush}">
                <StackPanel Margin="10,20,10,10">
                    <!-- 핫키 설정 -->
                    <TextBlock Text="{DynamicResource Pref_Hotkey_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource Pref_Hotkey_Desc}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox x:Name="HotKeyTextBox"
                                 Text="{Binding HotKeyDisplayText, Mode=OneWay}"
                                 Width="220" Padding="10,8" FontSize="14" FontWeight="Bold"
                                 IsReadOnly="True" Cursor="Hand"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{Binding HotKeyBorderBrush}" BorderThickness="1.5"
                                 PreviewKeyDown="HotKeyTextBox_PreviewKeyDown"
                                 GotFocus="HotKeyTextBox_GotFocus" />

                        <!-- 빨간색 충돌 표시 태그 -->
                        <Border Margin="10,0,0,0" Padding="10,4" Background="#FF5252" CornerRadius="4" VerticalAlignment="Center"
                                Visibility="{Binding HasConflict, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource Pref_Hotkey_Conflict}" Foreground="White" FontSize="12" FontWeight="Bold" />
                        </Border>
                    </StackPanel>

                    <!-- 상태 메세지 (성공 / 충돌 안내) -->
                    <TextBlock Text="{Binding HotKeyStatusText}"
                               Foreground="{Binding HotKeyStatusBrush}"
                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <!-- 언어 설정 (Language) -->
                    <TextBlock Text="{DynamicResource Pref_Language_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ComboBox SelectedIndex="{Binding SelectedLanguageIndex}" Width="280" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <ComboBoxItem Content="{DynamicResource Pref_Language_System}" />
                        <ComboBoxItem Content="{DynamicResource Pref_Language_Korean}" />
                        <ComboBoxItem Content="{DynamicResource Pref_Language_English}" />
                    </ComboBox>

                    <!-- 화면 테마 설정 -->
                    <TextBlock Text="{DynamicResource Pref_Theme_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ComboBox SelectedIndex="{Binding SelectedThemeIndex}" Width="280" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <ComboBoxItem Content="{DynamicResource Pref_Theme_Dark}" />
                        <ComboBoxItem Content="{DynamicResource Pref_Theme_Light}" />
                        <ComboBoxItem Content="{DynamicResource Pref_Theme_System}" />
                    </ComboBox>

                    <CheckBox Content="{DynamicResource Pref_LaunchAtStartup}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                               IsChecked="{Binding LaunchAtStartup}" Margin="0,0,0,16" />

                    <Button Content="{DynamicResource Pref_ResetGallerySize}"
                            Command="{Binding ResetGallerySizeCommand}"
                            HorizontalAlignment="Left" Padding="14,8"
                            Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                            Cursor="Hand" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>

            <!-- 검색 탭 -->
            <TabItem Header="{DynamicResource Pref_Tab_SearchOcr}" Foreground="{DynamicResource TextPrimaryBrush}">
                <StackPanel Margin="10,20,10,10">
                    <CheckBox Content="{DynamicResource Pref_OcrEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                               IsChecked="{Binding OcrEnabled}" Margin="0,0,0,15" />
                    <CheckBox Content="{DynamicResource Pref_SemanticEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                               IsChecked="{Binding SemanticSearchEnabled}" Margin="0,0,0,15" />
                </StackPanel>
            </TabItem>

            <!-- 변환 탭 -->
            <TabItem Header="{DynamicResource Pref_Tab_Conversion}" Foreground="{DynamicResource TextPrimaryBrush}">
                <StackPanel Margin="10,20,10,10">
                    <CheckBox Content="{DynamicResource Pref_WebpAutoConversion}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                               IsChecked="{Binding WebpConversionEnabled}" Margin="0,0,0,20" />

                    <!-- 원본 PNG 처분 정책 -->
                    <TextBlock Text="{DynamicResource Pref_DisposalPolicy_Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ComboBox SelectedIndex="{Binding SelectedDisposalIndex}" Width="280" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <ComboBoxItem Content="{DynamicResource Pref_Disposal_Trash}" />
                        <ComboBoxItem Content="{DynamicResource Pref_Disposal_Delete}" />
                        <ComboBoxItem Content="{DynamicResource Pref_Disposal_Keep}" />
                    </ComboBox>
                    <TextBlock Text="{DynamicResource Pref_Disposal_Note}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
