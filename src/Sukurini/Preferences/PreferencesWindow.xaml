<Window x:Class="Sukurini.Preferences.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sukurini 설정" Width="550" Height="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <TabControl Background="Transparent" BorderThickness="0">
            <!-- 일반 탭 -->
            <TabItem Header="일반" Foreground="{DynamicResource TextPrimaryBrush}">
                <StackPanel Margin="10,20,10,10">
                    <!-- 핫키 설정 -->
                    <TextBlock Text="갤러리 열기 핫키 (전역 단축키)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ComboBox SelectedIndex="{Binding SelectedHotKeyIndex}" Width="280" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <ComboBoxItem Content="⌨️ Ctrl + Alt + S (권장 - 충돌 없음)" />
                        <ComboBoxItem Content="⌨️ Alt + Shift + S" />
                        <ComboBoxItem Content="⌨️ Ctrl + Shift + S" />
                        <ComboBoxItem Content="⌨️ Alt + S" />
                        <ComboBoxItem Content="⌨️ Ctrl + Alt + K" />
                        <ComboBoxItem Content="⌨️ Alt + Shift + G" />
                    </ComboBox>

                    <!-- 화면 테마 설정 -->
                    <TextBlock Text="화면 테마 설정" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ComboBox SelectedIndex="{Binding SelectedThemeIndex}" Width="280" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <ComboBoxItem Content="🌙 다크 모드 (Dark)" />
                        <ComboBoxItem Content="☀️ 라이트 모드 (Light)" />
                        <ComboBoxItem Content="💻 시스템 설정 동기화 (System)" />
                    </ComboBox>

                    <CheckBox Content="Windows 시작 시 자동 실행" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                              IsChecked="{Binding LaunchAtStartup}" Margin="0,0,0,20" />

                    <Button Content="갤러리 패널 크기 기본값 복원"
                            Command="{Binding ResetGallerySizeCommand}"
                            HorizontalAlignment="Left" Padding="14,8"
                            Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                            Cursor="Hand" Margin="0,10,0,0" />
                </StackPanel>
            </TabItem>

            <!-- 검색 탭 -->
            <TabItem Header="검색 및 OCR" Foreground="{DynamicResource TextPrimaryBrush}">
                <StackPanel Margin="10,20,10,10">
                    <CheckBox Content="OCR 텍스트 자동 추출 및 검색 활성화" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                              IsChecked="{Binding OcrEnabled}" Margin="0,0,0,15" />
                    <CheckBox Content="MobileCLIP 시맨틱 이미지 검색 활성화" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                              IsChecked="{Binding SemanticSearchEnabled}" Margin="0,0,0,15" />
                </StackPanel>
            </TabItem>

            <!-- 변환 탭 -->
            <TabItem Header="이미지 변환" Foreground="{DynamicResource TextPrimaryBrush}">
                <StackPanel Margin="10,20,10,10">
                    <CheckBox Content="새 PNG 스크린샷 무손실 WebP 자동 변환" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                              IsChecked="{Binding WebpConversionEnabled}" Margin="0,0,0,20" />

                    <!-- 원본 PNG 처분 정책 -->
                    <TextBlock Text="변환 성공 후 원본 PNG 처분 정책" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ComboBox SelectedIndex="{Binding SelectedDisposalIndex}" Width="280" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <ComboBoxItem Content="🗑️ Windows 휴지통으로 이동 (기본값)" />
                        <ComboBoxItem Content="❌ 영구 삭제 (Delete)" />
                        <ComboBoxItem Content="📁 원본 PNG 보존 (Keep)" />
                    </ComboBox>
                    <TextBlock Text="* 안전 검증(1:1 픽셀 일치, 용량 절감 등)을 완전히 통과한 경우에만 처분됩니다."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
