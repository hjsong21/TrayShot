<Window x:Class="Sukurini.Gallery.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gallery="clr-namespace:Sukurini.Gallery"
        Title="Sukurini Gallery" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        Width="664" Height="480" MinWidth="400" MinHeight="300" MaxWidth="1400" MaxHeight="900"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="6">
        <!-- Main window content card -->
        <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Bar: Search Bar (Left) + Settings/Exit Buttons (Right) -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Bar -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🔍" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                                     FontSize="14" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" CaretBrush="{DynamicResource TextPrimaryBrush}" />

                            <!-- Clear Search Keyword Button (x) -->
                            <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" ToolTip="검색어 지우기"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0" Margin="4,0,0,0"
                                    Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="✖" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Action Buttons: Settings & Exit Icon -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Settings Button (Mechanical Gear Vector Icon) -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Margin="0,0,6,0">
                            <Button Click="OnOpenSettingsClick" ToolTip="설정"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="10,6">
                                <Path Data="M 12,15 A 3,3 0 1,0 12,9 A 3,3 0 1,0 12,15 Z M 19.43,12.97 C 19.47,12.65 19.5,12.33 19.5,12 C 19.5,11.67 19.47,11.34 19.43,11.03 L 21.54,9.37 C 21.73,9.22 21.78,8.95 21.66,8.73 L 19.66,5.27 C 19.54,5.05 19.27,4.96 19.05,5.05 L 16.56,6.05 C 16.04,5.66 15.48,5.32 14.87,5.07 L 14.49,2.42 C 14.46,2.18 14.25,2 14,2 H 10 C 9.75,2 9.54,2.18 9.51,2.42 L 9.13,5.07 C 8.52,5.32 7.96,5.66 7.44,6.05 L 4.95,5.05 C 4.73,4.96 4.46,5.05 4.34,5.27 L 2.34,8.73 C 2.21,8.95 2.27,9.22 2.46,9.37 L 4.57,11.03 C 4.53,11.34 4.5,11.67 4.5,12 C 4.5,12.33 4.53,12.65 4.57,12.97 L 2.46,14.63 C 2.27,14.78 2.21,15.05 2.34,15.27 L 4.34,18.73 C 4.46,18.95 4.73,19.03 4.95,18.95 L 7.44,17.95 C 7.96,18.34 8.52,18.68 9.13,18.93 L 9.51,21.58 C 9.54,21.82 9.75,22 10,22 H 14 C 14.25,22 14.46,21.82 14.87,18.93 C 15.48,18.68 16.04,18.34 16.56,17.95 L 19.05,18.95 C 19.27,19.03 19.54,18.95 19.66,18.73 L 21.66,15.27 C 21.78,15.05 21.73,14.78 21.54,14.63 L 19.43,12.97 Z"
                                      Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="16" Height="16" />
                            </Button>
                        </Border>

                        <!-- App Exit Button -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8">
                            <Button Click="OnExitAppClick" ToolTip="앱 종료"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="10,6">
                                <Path Data="M 13,3 H 4 C 3.4,3 3,3.4 3,4 V 20 C 3,20.6 3.4,21 4,21 H 13 V 19 H 5 V 5 H 13 Z M 15.5,7.5 L 14.1,8.9 L 17.2,12 H 8 V 14 H 17.2 L 14.1,17.1 L 15.5,18.5 L 21,13 V 11 Z"
                                      Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="16" Height="16" />
                            </Button>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Grid Items View -->
                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredScreenshots}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnItemMouseDoubleClick"
                         PreviewMouseMove="OnItemPreviewMouseMove">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="보기" InputGestureText="Space" Command="{Binding OpenPreviewCommand}" CommandParameter="{Binding SelectedItem}" />
                            <Separator />
                            <MenuItem Header="복사" InputGestureText="Ctrl+C" Command="{Binding CopySelectedCommand}" />
                            <MenuItem Header="붙여넣기" InputGestureText="Ctrl+V" Command="{Binding PasteClipboardCommand}" />
                            <Separator />
                            <MenuItem Header="포맷 변환">
                                <MenuItem Header="PNG" Command="{Binding ConvertFormatCommand}" CommandParameter="png" IsEnabled="{Binding IsNotPng}" />
                                <MenuItem Header="JPG" Command="{Binding ConvertFormatCommand}" CommandParameter="jpg" IsEnabled="{Binding IsNotJpg}" />
                                <MenuItem Header="WebP" Command="{Binding ConvertFormatCommand}" CommandParameter="webp" IsEnabled="{Binding IsNotWebp}" />
                                <MenuItem Header="BMP" Command="{Binding ConvertFormatCommand}" CommandParameter="bmp" IsEnabled="{Binding IsNotBmp}" />
                                <MenuItem Header="GIF" Command="{Binding ConvertFormatCommand}" CommandParameter="gif" IsEnabled="{Binding IsNotGif}" />
                                <MenuItem Header="TIFF" Command="{Binding ConvertFormatCommand}" CommandParameter="tiff" IsEnabled="{Binding IsNotTiff}" />
                                <MenuItem Header="HEIC" Command="{Binding ConvertFormatCommand}" CommandParameter="heic" IsEnabled="{Binding IsNotHeic}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="삭제" InputGestureText="Del" Command="{Binding DeleteSelectedCommand}" />
                            <MenuItem Header="취소" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnListBoxItemPreviewMouseRightButtonDown" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <gallery:ScreenshotItemControl ScreenshotItem="{Binding}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state message -->
                <TextBlock Grid.Row="1" Text="스크린샷이 없습니다." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <!-- Left resize border handle -->
        <Rectangle HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="8"
                   Fill="Transparent" Cursor="SizeWE"
                   PreviewMouseLeftButtonDown="ResizeLeft_MouseDown" />

        <!-- Top resize border handle -->
        <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="8"
                   Fill="Transparent" Cursor="SizeNS"
                   PreviewMouseLeftButtonDown="ResizeTop_MouseDown" />

        <!-- Top-Left corner resize handle -->
        <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="14"
                   Fill="Transparent" Cursor="SizeNWSE"
                   PreviewMouseLeftButtonDown="ResizeTopLeft_MouseDown" />
    </Grid>
</Window>
