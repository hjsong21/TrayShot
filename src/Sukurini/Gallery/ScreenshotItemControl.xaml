<UserControl x:Class="Sukurini.Gallery.ScreenshotItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Height="124" Margin="6">
    <Border CornerRadius="8" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Image x:Name="ThumbnailImage" Stretch="UniformToFill" />
            
            <!-- Video badge indicator -->
            <Border x:Name="VideoBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                    Background="#80000000" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                <TextBlock Text="▶ VIDEO" Foreground="White" FontSize="10" FontWeight="Bold" />
            </Border>
            
            <!-- File name overlay at bottom -->
            <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="6,4">
                <TextBlock x:Name="FileNameText" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Border>
</UserControl>
